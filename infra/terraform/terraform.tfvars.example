# Copy this file outside the repository before replacing the placeholder values.
# Do not add bearer, OAuth, refresh-token, or service-account-key values here.
project_id               = "replace-with-project-id"
container_image          = "replace-with-registry-image@sha256:replace-with-64-hex-digest"
drive_auth_mode          = "shared-drive-adc"
root_folder_id           = "replace-with-root-folder-id"
archive_folder_id        = "replace-with-archive-folder-id"
shared_drive_id          = "replace-with-shared-drive-id"
codex_bearer_secret_id   = "replace-with-existing-codex-secret-id"
work_mcp_issuer          = "https://issuer.example.invalid"
work_mcp_audience        = "replace-with-audience"
work_mcp_jwks_url        = "https://keys.example.invalid/jwks"
work_mcp_max_token_lifetime_seconds = 3600

# Bounded tree-read defaults; keep content searching within traversal bounds.
max_path_depth           = 100
max_metadata_checks      = 100000
max_content_search_files = 1000

# Required only for a reviewed full plan/apply that creates or changes Cloud Run.
# Keep false for the reviewed Artifact Registry bootstrap apply.
acknowledge_production_service_apply = false

# Runtime writes are disabled by default. Enabling requires a separate reviewed
# acknowledgement and does not replace the dedicated-root release evidence.
enable_write             = false
acknowledge_write_risk   = false

# Public invocation is separately disabled and requires its own acknowledgement.
allow_public_invoker       = false
acknowledge_public_invoker = false

# For my-drive-refresh-token instead, set drive_auth_mode accordingly and set only the
# existing OAuth secret identifier. Its payload stays in Secret Manager.
# oauth_secret_id = "replace-with-existing-oauth-secret-id"
